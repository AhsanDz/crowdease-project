                "readings"
              ]
            },
            "description": "Submit satu pembacaan sensor (penumpang naik/turun). Bila kepadatan tinggi, sistem akan trigger forecast update dan webhook outbound (jika TI-2 aktif).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"passenger_count\": 35,\n  \"capacity_at_time\": 60,\n  \"recorded_at\": \"2026-05-23T10:32:15+07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Returns density log with computed ratio', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('occupancy_ratio');",
                  "    pm.expect(parseFloat(data.occupancy_ratio)).to.be.within(0, 2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
